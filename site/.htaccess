# +1 by RDNA website
Options -Indexes
DirectoryIndex index.php

# This site often lives in a folder inside another website's folder (an addon
# domain). Switching the rewrite engine on here, with no rules, stops the outer
# website's rewrite rules from being applied to this one.
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

<FilesMatch "^(config\.php|INSTALL\.md|.*\.sqlite)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
